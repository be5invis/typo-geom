{
	"compilerOptions": {
		"target": "es2020",
		"strict": true,
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"allowSyntheticDefaultImports": true,
		"jsx": "preserve",
		"importHelpers": true,
		"alwaysStrict": true,
		"sourceMap": true,
		"forceConsistentCasingInFileNames": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noImplicitAny": true,
		"noImplicitThis": true,
		"noUnusedLocals": false,
		"strictNullChecks": true,
		"declaration": true,
		"types": ["node", "jest"],
		"rootDir": "src",
		"outDir": "lib"
	},
	"include": ["src/**/*"]
}
